<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Under Maintenance</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      html, body {
        height: 100%;
        margin: 0;
      }
      .full-height {
        height: 100vh;
      }
    </style>
  </head>
  <body>
    <div class="d-flex full-height">
      <!-- Left: Image 30% -->
      <div class="w-30 d-flex align-items-center justify-content-center" style="width: 30%;">
        <img
          src="https://lirp.cdn-website.com/709bf89b/dms3rep/multi/opt/Website-Under-Construction--28mobile-29-1920w.png"
          alt="Under Construction"
          class="img-fluid h-100"
          style="object-fit: cover;"
          loading="lazy"
        />
      </div>

      <!-- Right: Text 70% -->
      <div class="w-70 d-flex flex-column justify-content-center align-items-center text-center bg-light" style="width: 70%;">
        <h1 class="fw-bold text-dark">We'll Be Right Back</h1>
        <p class="text-muted fs-5">This site is currently undergoing maintenance. </p>
        <footer class="mt-4 text-secondary">
          © <span id="year"></span> Maf, All rights reserved.
        </footer>
      </div>
    </div>

    <script>
      document.getElementById("year").textContent = new Date().getFullYear();
    </script>
  </body>
</html>
